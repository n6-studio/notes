# Convex
CONVEX_DEPLOYMENT=

# Browser (Better Auth client base URL; match SITE_URL in local dev)
VITE_SITE_URL=http://localhost:3000

# Convex backend (Better Auth server); match VITE_SITE_URL in local dev
SITE_URL=http://localhost:3000

# From Convex dashboard → Settings → URL & Deploy Key
# VITE_CONVEX_URL ends in .convex.cloud
VITE_CONVEX_URL=
# Convex HTTP / site URL for Better Auth handler proxy — ends in .convex.site
VITE_CONVEX_SITE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set in Convex dashboard (or `npx convex env set`): secret for Better Auth JWT
# BETTER_AUTH_SECRET=
#
# Optional: static JWKS JSON for faster JWT verification (see kitcn auth docs)
# JWKS=
