# Convex
CONVEX_DEPLOYMENT=

# Site / auth (Better Auth + Google OAuth)
# Local dev: match the Vite dev server URL (default port 3000 for this app)
SITE_URL=http://localhost:3000

# From Convex dashboard → Settings → URL & Deploy Key
# VITE_CONVEX_URL ends in .convex.cloud
VITE_CONVEX_URL=
# Convex HTTP / site URL for Better Auth handler proxy — ends in .convex.site
VITE_CONVEX_SITE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set in Convex dashboard (or `npx convex env set`): secret for Better Auth JWT
# BETTER_AUTH_SECRET=
