{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!!**/.agents",
      "!!**/.zed",
      "**/src/**/*",
      "!**/src/components/ui",
      "**/convex/**/*.ts",
      "!**/convex/_generated",
      "**/.vscode/**/*",
      "**/index.html",
      "**/vite.config.ts",
      "**/vitest.config.ts",
      "!**/src/routeTree.gen.ts",
      "!**/src/styles.css",
      "!**/src/locales"
    ]
  },
  "overrides": [
    {
      "includes": ["**/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/convex/**/*.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
